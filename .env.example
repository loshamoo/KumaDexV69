# WalletConnect Project ID
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# SwapXFeeRouter (on-chain sweep hop). Set after deploy. This does NOT redirect LI.FI fees by itself —
# the owner must set the kumadex integrator fee wallet to this router in the LI.FI Partner Portal.
NEXT_PUBLIC_SWAPX_FEE_ROUTER=
